# HealthEasy-G Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healtheasy_g?schema=public"

# Secret used to sign HMS staff session cookies (HMAC-SHA256).
# Generate a strong value, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The application refuses to start in production if this is unset or shorter than 32 characters.
SESSION_SECRET="change-me-to-a-long-random-value-at-least-32-chars"

# Session lifetime in seconds (default 8 hours — one hospital shift)
SESSION_MAX_AGE_SECONDS="28800"

# Next.js application environment
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="HealthEasy-G HMS"
NEXT_PUBLIC_FACILITY_CODE="GAR-RIDGE-01"
