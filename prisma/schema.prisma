// HealthEasy-G PostgreSQL Database Schema (Prisma ORM)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LicenseStatus {
  ACTIVE
  PENDING_RENEWAL
  EXPIRED
}

enum LicensingBody {
  MDC
  NMC
  PHARMACY_COUNCIL
  AHPC
  OTHER
}

enum PatientCategory {
  CASH
  NHIS
  CORPORATE
  PRIVATE_INSURANCE
  EXEMPTED
}

enum EmergencySeverity {
  ESI_1_RESUSCITATION
  ESI_2_EMERGENCY
  ESI_3_URGENT
  ESI_4_LESS_URGENT
  ESI_5_NON_URGENT
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
  ISOLATION
}

enum QueueStatus {
  WAITING
  IN_CONSULTATION
  COMPLETED
  TRANSFERRED
}

enum PriorityLevel {
  NORMAL
  URGENT
  EMERGENCY
}

// ----------------------------------------------------
// 1. FACILITY & SYSTEM MANAGEMENT
// ----------------------------------------------------

model FacilityBranch {
  id              String        @id @default(uuid())
  name            String
  code            String        @unique
  hefraLicenseNo  String
  hefraExpiryDate String
  hefraStatus     LicenseStatus @default(ACTIVE)
  location        String
  gpsAddress      String
  phone           String
  email           String
  // Displayed throughout hospitals-management but previously missing from the
  // schema, so any facility loaded from the database rendered blank cells.
  region          String        @default("Greater Accra")
  facilityType    String        @default("District")
  status          String        @default("Active")
  adminName       String        @default("Unassigned")
  adminEmail      String        @default("")
  bedCapacity     Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ----------------------------------------------------
// 2. USER & STAFF CREDENTIALS (20-ROLE HIERARCHY)
// ----------------------------------------------------

model UserStaff {
  id            String        @id @default(uuid())
  name          String
  role          String // 20 HMS Roles
  hierarchyLevel Int          @default(4) // Level 1 to 4
  reportsTo     String?
  staffId       String        @unique
  licenseNumber String?
  licensingBody LicensingBody @default(OTHER)
  licenseExpiry String?
  status        String        @default("Active")
  department    String
  email         String        @unique
  passwordHash  String        @default("$2b$10$e8vK3g...default")
  phone         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  vitalsRecorded   VitalSigns[]     @relation("RecordedVitals")
  labResults       LabOrder[]       @relation("VerifiedLabResults")
  dispenses        DispenseRecord[] @relation("DispensedBy")
  encountersSigned EMREncounter[]   @relation("SignedEncounters")
  auditLogs        AuditLog[]
}

// ----------------------------------------------------
// 3. MASTER PATIENT INDEX (MPI) & REGISTRATION
// ----------------------------------------------------

model Patient {
  id                 String          @id @default(uuid())
  mrn                String          @unique // Medical Record Number
  facilityId         String          @default("fac-1")
  fullName           String
  dob                String
  gender             String
  phone              String
  ghanaCardNo        String          @unique
  nhisNumber         String?
  nhisStatus         String?         @default("Active")
  nhisExpiry         String?
  patientCategory    PatientCategory @default(CASH)
  gpsAddress         String
  residentialAddress String
  emergencyContact   Json // { name, relationship, phone }
  allergies          String[]
  chronicConditions  String[]
  bloodGroup         String          @default("O+")
  registrationDate   String
  photoUrl           String?
  consentSigned      Boolean         @default(true)
  mergedWithMrn      String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  queues          QueueItem[]
  vitals          VitalSigns[]
  encounters      EMREncounter[]
  labOrders       LabOrder[]
  radiologyOrders RadiologyOrder[]
  dispenses       DispenseRecord[]
  invoices        BillingInvoice[]
  nhisClaims      NHISClaimLine[]
  medicationAdmin MedicationAdministrationRecord[]
  auditLogs       AuditLog[]
}

// ----------------------------------------------------
// 4. QUEUE & PATIENT FLOW MANAGEMENT
// ----------------------------------------------------

model QueueItem {
  id              String        @id @default(uuid())
  patientId       String
  mrn             String
  patientName     String
  patientCategory PatientCategory
  department      String // Triage, OPD Consultation, Emergency, Laboratory, etc.
  servicePoint    String
  queueNumber     String
  arrivalTime     String
  waitingMinutes  Int           @default(0)
  priority        PriorityLevel @default(NORMAL)
  status          QueueStatus   @default(WAITING)
  currentLocation String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 5. TRIAGE & NURSING VITALS
// ----------------------------------------------------

model VitalSigns {
  id                 String            @id @default(uuid())
  patientId          String
  encounterId        String?
  timestamp          DateTime          @default(now())
  systolicBp         Int
  diastolicBp        Int
  pulseRate          Int
  temperature        Float
  respiratoryRate    Int
  oxygenSaturation   Int
  weightKg           Float
  heightCm           Float
  bmi                Float
  bloodGlucoseMmoles Float             @default(5.5)
  painScore          Int               @default(0)
  pregnancyStatus    String?
  esiSeverity        EmergencySeverity @default(ESI_3_URGENT)
  nursingNotes       String
  abnormalAlerts     String[]
  recordedById       String?
  recordedByName     String

  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy UserStaff? @relation("RecordedVitals", fields: [recordedById], references: [id])
}

// ----------------------------------------------------
// 6. EMR & CLINICAL CONSULTATION
// ----------------------------------------------------

model EMREncounter {
  id             String   @id @default(uuid())
  patientId      String
  mrn            String
  patientName    String
  timestamp      DateTime @default(now())
  encounterType  String   @default("OPD")
  chiefComplaint String
  historyOfIllness String
  pastMedicalHistory String @default("")
  physicalExam   String
  icdDiagnoses   Json // Array of { code, name, category }
  orders         Json // Array of ClinicalOrder
  clinicalNotes  String   @default("")
  treatmentPlan  String
  dischargeDecision String?
  signed         Boolean  @default(true)
  sickLeaveDays  Int      @default(0)
  signedById     String?
  clinicianName  String
  signedAt       DateTime @default(now())

  patient  Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  signedBy UserStaff? @relation("SignedEncounters", fields: [signedById], references: [id])
}

// ----------------------------------------------------
// 7. INPATIENT WARDS & BEDS
// ----------------------------------------------------

model InpatientBed {
  id               String    @id @default(uuid())
  wardName         String
  bedNumber        String    @unique
  bedType          String
  status           BedStatus @default(AVAILABLE)
  currentPatientId String?
  patientName      String?
  mrn              String?
  admissionDate    String?
  assignedNurse    String?
  dailyRateGhc     Float
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ----------------------------------------------------
// 8. LABORATORY INFORMATION SYSTEM (LIS)
// ----------------------------------------------------

model LabOrder {
  id               String   @id @default(uuid())
  encounterId      String?
  patientId        String
  mrn              String
  patientName      String
  testCode         String
  testName         String
  testCategory     String   @default("General Pathology")
  specimenType     String
  barcodeNo        String   @unique
  orderedBy        String
  orderTimestamp   String
  collectedAt      String?
  receivedAt       String?
  technicianName   String?
  status           String   @default("Ordered") // Ordered, Specimen Collected, In Analysis, Verified, Completed
  results          Json? // Object mapping test parameters to values & ranges
  verifiedById     String?
  verifiedByName   String?
  verificationTime String?
  createdAt        DateTime @default(now())

  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  verifiedBy UserStaff? @relation("VerifiedLabResults", fields: [verifiedById], references: [id])
}

model LabTestCatalogue {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  category     String
  specimenType String   @default("Blood / Plasma")
  costGhc      Float
  nhisCovered  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ----------------------------------------------------
// 9. RADIOLOGY & DIAGNOSTIC IMAGING (PACS)
// ----------------------------------------------------

model RadiologyOrder {
  id               String   @id @default(uuid())
  patientId        String
  mrn              String
  patientName      String
  studyType        String // X-Ray, Ultrasound, CT Scan, MRI
  bodyPart         String
  clinicalHistory  String
  pregnancyScreened Boolean @default(false)
  radiographerNotes String?
  orderedBy        String
  orderTimestamp   String
  status           String   @default("Ordered")
  pacsAccessionNo  String   @unique
  imageUrls        String[]
  reportContent    String?
  radiologistName  String?
  signedTimestamp  String?
  criticalFindings Boolean  @default(false)
  createdAt        DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 10. PHARMACY & FEFO BATCH STOCK
// ----------------------------------------------------

model PharmacyBatch {
  id                String   @id @default(uuid())
  drugCode          String
  drugName          String // Generic (INN) name
  brandName         String   @default("")
  dosageForm        String   @default("Tablet")
  strength          String   @default("")
  category          String
  batchNumber       String   @unique
  expiryDate        String
  quantityInStock   Int
  reorderLevel      Int      @default(50)
  unitCostGhc       Float
  sellingPriceGhc   Float
  nhisCovered       Boolean  @default(true)
  controlledSubstance Boolean @default(false)
  supplier          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dispenses DispenseRecord[]
}

model DispenseRecord {
  id                 String   @id @default(uuid())
  prescriptionId     String
  patientId          String
  mrn                String
  patientName        String
  drugName           String
  dosageInstructions String
  quantityPrescribed Int
  quantityDispensed  Int
  batchNumber        String
  dispensedById      String?
  dispensedByName    String
  dispenseTimestamp  DateTime @default(now())
  status             String   @default("Dispensed")
  counselingNotes    String?

  patient     Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  batch       PharmacyBatch  @relation(fields: [batchNumber], references: [batchNumber])
  dispensedBy UserStaff?     @relation("DispensedBy", fields: [dispensedById], references: [id])
}

// ----------------------------------------------------
// 11. BILLING & CASHIER OPERATIONS
// ----------------------------------------------------

model BillingInvoice {
  id               String          @id @default(uuid())
  invoiceNumber    String          @unique
  patientId        String
  mrn              String
  patientName      String
  patientCategory  PatientCategory
  subtotalGhc      Float
  nhisExemptionGhc Float           @default(0)
  totalAmountGhc   Float
  paidAmountGhc    Float           @default(0)
  balanceGhc       Float
  status           String          @default("Unpaid")
  paymentMethod    String?
  cashierName      String?
  receiptNumber    String?
  createdAt        DateTime        @default(now())
  lineItems        Json // Array of BillingLineItem

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 12. NHIS & INSURANCE CLAIMS ENGINE
// ----------------------------------------------------

model NHISClaimLine {
  id                String   @id @default(uuid())
  claimNumber       String   @unique
  batchId           String?
  patientId         String
  mrn               String
  patientName       String
  nhisNumber        String
  gender            String
  dob               String
  attendanceDate    String
  verificationRef   String   @default("")
  icdCode           String
  icdDescription    String
  gdrgCode          String
  gdrgTariffGhc     Float
  medicineCode      String   @default("N/A")
  medicineTariffGhc Float    @default(0)
  totalClaimGhc     Float
  status            String   @default("Validated")
  rejectionReason   String?
  auditFlags        String[]
  createdAt         DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 13. INVENTORY & STORES PROCUREMENT
// ----------------------------------------------------

model InventoryStoreItem {
  id            String   @id @default(uuid())
  itemCode      String   @unique
  itemName      String
  category      String
  storeLocation String   @default("Central Store")
  batchNo       String   @default("N/A")
  expiryDate    String   @default("")
  quantity      Int
  unit          String
  unitPriceGhc  Float
  reorderPoint  Int      @default(20)
  supplier      String
  lastRestocked String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ----------------------------------------------------
// 14. MEDICATION ADMINISTRATION RECORD (MAR)
// ----------------------------------------------------

model MedicationAdministrationRecord {
  id               String   @id @default(uuid())
  encounterId      String?
  patientId        String
  patientName      String
  bedNumber        String
  drugName         String
  dosage           String
  route            String
  dueTime          String
  administeredTime String?
  status           String   @default("Scheduled") // Scheduled, Administered, Omitted, Refused
  administeredById String?
  administeredBy   String?
  omissionReason   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 15. NHIS CLAIM BATCHES (CLAIM-it submission envelopes)
// ----------------------------------------------------

model NHISClaimBatch {
  id             String   @id @default(uuid())
  batchNo        String   @unique
  monthYear      String // e.g. "2026-07"
  facilityCode   String
  claimCount     Int      @default(0)
  totalAmountGhc Float    @default(0)
  status         String   @default("Prepared") // Prepared, Exported CLAIM-it, Submitted to NHIA, Reconciled
  preparedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ----------------------------------------------------
// 16. DHIMS2 MONTHLY RETURN
//
// Most DHIMS2 figures are derived from live clinical data. The few that are
// not captured anywhere else in the system (deaths, deliveries) are recorded
// here by the records officer, exactly as they are on the paper return.
// ----------------------------------------------------

model DhimsMonthlyReturn {
  id                 String   @id @default(uuid())
  monthYear          String   @unique // "2026-07"
  facilityCode       String   @default("GAR-RIDGE-01")
  totalDeaths        Int      @default(0)
  maternalDeliveries Int      @default(0)
  totalDischarges    Int      @default(0)
  submittedBy        String?
  submittedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ----------------------------------------------------
// 17. IMMUTABLE DPC AUDIT LOG TRAIL
// ----------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  userId      String?
  userName    String
  role        String
  action      String
  patientId   String?
  mrn         String?
  details     String
  ipAddress   String   @default("127.0.0.1")

  user    UserStaff? @relation(fields: [userId], references: [id])
  patient Patient?   @relation(fields: [patientId], references: [id])
}
