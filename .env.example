# HealthEasy-G Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---------------------------------------------------------------------------
# Database — the system runs against a local PostgreSQL when the facility is
# offline, and a managed cloud PostgreSQL when it is online. Both use the same
# Prisma schema and the same seed, so switching is only a connection change.
#
#   DATABASE_TARGET=local   ->  uses DATABASE_URL_LOCAL
#   DATABASE_TARGET=cloud   ->  uses DATABASE_URL_CLOUD
#
# Setting DATABASE_URL directly overrides both (used by CI and by hosting
# providers that inject their own connection string).
# ---------------------------------------------------------------------------
DATABASE_TARGET="cloud"

DATABASE_URL_LOCAL="postgresql://postgres:postgres@localhost:5432/healtheasy_g?schema=public"
DATABASE_URL_CLOUD="postgresql://user:password@your-host.neon.tech/neondb?sslmode=require"

# Secret used to sign HMS staff session cookies (HMAC-SHA256).
# Generate a strong value, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The application refuses to sign sessions in production if this is unset or shorter than 32 characters.
SESSION_SECRET="change-me-to-a-long-random-value-at-least-32-chars"

# Session lifetime in seconds (default 8 hours — one hospital shift)
SESSION_MAX_AGE_SECONDS="28800"

# Optional: local Ollama model used by the clinical decision-support assistant.
# If it is unreachable the API falls back to the built-in GSTG rule engine.
OLLAMA_MODEL="llama3.1"
OLLAMA_TIMEOUT_MS="15000"
# Disabled by default: enabling this may transmit patient data to the Ollama
# endpoint. Enable only after completing the required privacy review.
AI_EXTERNAL_PROCESSING_ENABLED="false"

# Next.js application environment
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="HealthEasy-G HMS"
NEXT_PUBLIC_FACILITY_CODE="GAR-RIDGE-01"
